#include <windows.h>

1 24 "app.manifest"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "local"
            VALUE "FileDescription", "MusicUnlock - 加密音频转 MP3"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "MusicUnlock"
            VALUE "OriginalFilename", "MusicUnlock.exe"
            VALUE "ProductName", "MusicUnlock"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
